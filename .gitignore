__pycache__/
*.pyc
*.nbi
*.nbc

# The web site (its own git repository, see make_site.py)
site/

# Raw games for the dashboard (make_dashboard.py puts the summary in dashboard.html)
results/dashboard_data.json
results/selfplay_data.json

